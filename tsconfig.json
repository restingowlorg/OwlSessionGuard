{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "module": "Node16",
    "target": "ES2019",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
  },
  "include": ["src"]
}