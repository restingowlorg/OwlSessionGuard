{
  "name": "@restingowlorg/owl-session",
  "version": "1.0.1",
  "description": "A framework-agnostic, database-agnostic authentication library for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --declaration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "test": "jest"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "authentication",
    "auth",
    "auth-library",
    "node-auth",
    "framework-agnostic",
    "backend-auth",
    "session-auth",
    "password-auth",
    "magic-link",
    "passwordless",
    "login",
    "signup",
    "security",
    "user-auth",
    "nodejs",
    "typescript",
    "clean-architecture",
    "hexagonal-architecture",
    "backend",
    "api-auth",
    "express-auth",
    "nest-auth"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "secretlint": "^12.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^12.0.0",
    "@eslint/js": "^9.21.0",
    "typescript-eslint": "^8.25.0",
    "typescript": "^6.0.3",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OSSecPlatform/ossec-auth-library"
  }
}
